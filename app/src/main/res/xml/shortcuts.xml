<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_voice"
        android:shortcutId="voice"
        android:shortcutLongLabel="@string/shortcut_voice_long"
        android:shortcutShortLabel="@string/shortcut_voice_short">
        <intent
            android:action="com.aydinsogut.reminder.action.VOICE"
            android:targetClass="com.aydinsogut.reminder.ui.MainActivity"
            android:targetPackage="com.aydinsogut.reminder" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_add"
        android:shortcutId="new"
        android:shortcutLongLabel="@string/shortcut_new_long"
        android:shortcutShortLabel="@string/shortcut_new_short">
        <intent
            android:action="com.aydinsogut.reminder.action.ADD"
            android:targetClass="com.aydinsogut.reminder.ui.MainActivity"
            android:targetPackage="com.aydinsogut.reminder" />
    </shortcut>
</shortcuts>
